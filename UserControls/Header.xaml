<UserControl x:Class="Holst.UserControls.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Holst.UserControls"
             mc:Ignorable="d" 
             MinHeight="40" MaxHeight="40" Height="40" MinWidth="510">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Проекты" 
           Grid.Column="1" 
           FontWeight="Light"
           Foreground="White" 
           TextAlignment="Center"
           VerticalAlignment="Center"
           FontSize="28"
           FontFamily="Calibri"/>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="25,0,0,0">
            <Button Style="{StaticResource HeaderMiniBtn}" />
            <Button Style="{StaticResource HeaderMiniBtn}"/>
            <Button Style="{StaticResource HeaderMiniBtn}"/>
        </StackPanel>
        <Line Grid.ColumnSpan="3" X1="0" X2="600" Stroke="#4C4C4C" VerticalAlignment="Bottom" Stretch="Uniform" StrokeThickness="1" />
    </Grid>
</UserControl>
