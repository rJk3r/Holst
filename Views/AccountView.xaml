<UserControl x:Class="Holst.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Holst.Views"
             xmlns:UserControls="clr-namespace:Holst.UserControls"
             mc:Ignorable="d" 
             MinWidth="900" MinHeight="564">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <UserControls:HubNavigator Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"/>
        <Path Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
              Stroke="#4C4C4C"
              StrokeThickness="1" 
              Fill="Transparent"
              Stretch="Fill"
              HorizontalAlignment="Left" VerticalAlignment="Top">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="0,565">
                        <LineSegment Point="0, 15"/>
                        <ArcSegment Point="15,0" Size="15,15" SweepDirection="Clockwise"/>
                        <LineSegment Point="15, 0"/>
                        <LineSegment Point="905, 0"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>

        <ScrollViewer Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Margin="15,5,15,15" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,20,20,20">
                <TextBlock Text="Аккаунт" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,0,0,25"/>

                <TextBlock Text="{Binding UserName}" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding LastLoginDateText, StringFormat='Последний вход: {0}'}" Foreground="#AAAAAA" FontSize="14" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding Role, StringFormat='Роль: {0}'}" Foreground="#AAAAAA" FontSize="14" Margin="0,0,0,20"/>

                <Button Content="Стать админом"
                        Command="{Binding BecomeAdminCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="220" Height="45"
                        Margin="0,0,0,20"
                        Visibility="{Binding BecomeAdminButtonVisibility}"/>

                <StackPanel Visibility="{Binding AdminPanelVisibility}">
                    <TextBlock Text="Управление пользователями" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBox Text="{Binding TargetUserName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Input}"
                             Width="300"
                             Margin="0,0,0,12"
                             ToolTip="Имя пользователя"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Удалить"
                                Command="{Binding DeleteUserCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Width="140" Height="40"
                                Margin="0,0,10,0"/>
                        <Button Content="Сбросить пароль на 1234"
                                Command="{Binding ResetPasswordCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Width="200" Height="40"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#00FF00"
                           FontSize="14"
                           Margin="0,15,0,0"
                           TextWrapping="Wrap"
                           MaxWidth="600"/>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
