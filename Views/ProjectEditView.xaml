<UserControl x:Class="Holst.Views.ProjectEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Holst.Views"
             xmlns:UserControls="clr-namespace:Holst.UserControls"
             mc:Ignorable="d" 
             MinWidth="900" MinHeight="564">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Path Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
              Stroke="#4C4C4C"
              StrokeThickness="1" 
              Fill="Transparent"
              Stretch="Fill"
              HorizontalAlignment="Left" VerticalAlignment="Top">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="0,565">
                        <LineSegment Point="0, 15"/>
                        <ArcSegment Point="15,0" Size="15,15" SweepDirection="Clockwise"/>
                        <LineSegment Point="15, 0"/>
                        <LineSegment Point="905, 0"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>

        <Grid Grid.Row="0" Grid.Column="1" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <UserControls:Header Grid.Row="0" Panel.ZIndex="1000" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="15,10,15,10">
                <Button Content="Импорт (.Holst)" 
                        Command="{Binding ImportProjectCommand}" 
                        Style="{StaticResource PrimaryButton}" 
                        Width="160" Height="45" Margin="0,0,10,0"/>
                <Button Content="Экспорт (.Holst)" 
                        Command="{Binding ExportProjectCommand}" 
                        Style="{StaticResource PrimaryButton}" 
                        Width="160" Height="45" Margin="0,0,10,0"/>
                <Button Content="Сохранить" 
                        Command="{Binding SaveProjectCommand}"
                        CommandParameter="{Binding ElementName=EditorRichTextBox, Path=Document}"
                        Style="{StaticResource PrimaryButton}" 
                        Width="120" Height="45"/>
                <TextBlock Text="{Binding ProjectTitle}" 
                           Foreground="White" 
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center" 
                           Margin="20,0,0,0"/>
            </StackPanel>

            <Border Grid.Row="2" 
                    Background="#1E1E1E" 
                    BorderBrush="#4C4C4C" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Margin="15,0,15,15">
                <RichTextBox x:Name="EditorRichTextBox" 
                             Background="Transparent" 
                             Foreground="White" 
                             BorderThickness="0" 
                             Padding="12" 
                             FontFamily="Consolas" 
                             FontSize="14"
                             LostFocus="EditorRichTextBox_LostFocus"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"/>
            </Border>

            <TextBlock Grid.Row="2" 
                       Text="{Binding StatusMessage}" 
                       Foreground="#AAAAAA" 
                       FontSize="12" 
                       Margin="15,0,15,5" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Bottom"/>
        </Grid>

    </Grid>
</UserControl>
