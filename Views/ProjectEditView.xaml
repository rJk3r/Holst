<UserControl x:Class="Holst.Views.ProjectEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Holst.Views"
             xmlns:UserControls="clr-namespace:Holst.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <UserControls:HubNavigator Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"/>
        <Path Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
              Stroke="#4C4C4C"
              StrokeThickness="1" 
              Fill="Transparent"
              Stretch="Fill"
              HorizontalAlignment="Left" VerticalAlignment="Top">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="0,565">
                        <LineSegment Point="0, 15"/>
                        <ArcSegment Point="15,0" Size="15,15" SweepDirection="Clockwise"/>
                        <LineSegment Point="15, 0"/>
                        <LineSegment Point="905, 0"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>

        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Управление проектом" Foreground="White" FontSize="24" FontFamily="Calibri" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource Input}" 
                     Width="300" 
                     Margin="0,0,0,10"
                     ToolTip="Название проекта"/>
            <Button Content="Импорт (.Holst)" 
                    Command="{Binding ImportProjectCommand}" 
                    Style="{StaticResource PrimaryButton}" 
                    Width="300" Height="45" Margin="0,0,0,10"/>
            <Button Content="Экспорт (.Holst)" 
                    Command="{Binding ExportProjectCommand}" 
                    Style="{StaticResource PrimaryButton}" 
                    Width="300" Height="45"/>
            <TextBlock Text="{Binding StatusMessage}" 
                       Foreground="#AAAAAA" 
                       FontSize="12" 
                       Margin="0,15,0,0" 
                       HorizontalAlignment="Center" 
                       TextWrapping="Wrap" 
                       MaxWidth="300"/>
        </StackPanel>

    </Grid>
</UserControl>
